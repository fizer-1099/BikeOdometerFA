<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F1F4F9"
    android:fitsSystemWindows="true"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ============ صفحه‌ی اصلی ============ -->
        <LinearLayout
            android:id="@+id/homePage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="● متوقف"
                    android:textColor="#78828F"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/clockText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--:--:--"
                    android:textColor="#0288D1"
                    android:textSize="16sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <Button
                    android:id="@+id/tabGauge"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_primary"
                    android:text="کیلومترشمار"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/tabMap"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_tab"
                    android:text="ردیابی مسیر"
                    android:textColor="#3C4655" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:id="@+id/gaugePage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <ir.balasari.bikeodometer.GaugeView
                        android:id="@+id/gauge"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <TextView
                            android:id="@+id/limitText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="سقف مجاز: 30 km/h"
                            android:textColor="#1B2430"
                            android:textSize="15sp" />

                        <Button
                            android:id="@+id/limitMinus"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="@drawable/bg_tab"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="−"
                            android:textSize="20sp" />

                        <Button
                            android:id="@+id/limitPlus"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_tab"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:text="+"
                            android:textSize="20sp" />

                        <Button
                            android:id="@+id/limitSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_tab"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="🔕 خاموش" />
                    </LinearLayout>
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/mapPage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">

                    <org.osmdroid.views.MapView
                        android:id="@+id/map"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <Button
                        android:id="@+id/followButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_gravity="top|start"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_primary"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="دنبال کردن من"
                        android:textColor="#FFFFFF" />

                    <LinearLayout
                        android:id="@+id/viewBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_margin="12dp"
                        android:background="@drawable/bg_card"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="8dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/viewBannerText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="سفر"
                            android:textColor="#1B2430"
                            android:textSize="14sp" />

                        <Button
                            android:id="@+id/viewBannerClose"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_primary"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="بازگشت به سفر جاری"
                            android:textColor="#FFFFFF" />
                    </LinearLayout>
                </FrameLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_card"
                android:padding="8dp">

                <Button
                    android:id="@+id/rideButton"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_primary"
                    android:text="شروع سفر"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="مسافت (km)"
                        android:textColor="#78828F"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/distanceValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="۰٫۰۰"
                        android:textColor="#0288D1"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="میانگین (km/h)"
                        android:textColor="#78828F"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/avgValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="۰٫۰"
                        android:textColor="#0288D1"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="حداکثر (km/h)"
                        android:textColor="#78828F"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/maxValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="۰٫۰"
                        android:textColor="#0288D1"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="زمان سفر"
                        android:textColor="#78828F"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tripTimeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="۰۰:۰۰:۰۰"
                        android:textColor="#0288D1"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============ سفرها ============ -->
        <LinearLayout
            android:id="@+id/tripsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="سفرها"
                    android:textColor="#1B2430"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/exportButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tab"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:text="خروجی CSV"
                    android:textColor="#3C4655" />
            </LinearLayout>

            <TextView
                android:id="@+id/tripsEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="32dp"
                android:text="هنوز سفری ذخیره نشده است."
                android:textColor="#78828F"
                android:textSize="15sp" />

            <ListView
                android:id="@+id/tripsList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- ============ رکوردها ============ -->
        <ScrollView
            android:id="@+id/recordsPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/recordsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp" />
        </ScrollView>
    </FrameLayout>

    <!-- ============ نوار پایین ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navHud"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navHolder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navTrips"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/navRecords"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="8dp"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
